#include <math.h>
#include <Wire.h>

#ifndef PI
#define PI 3.14159265 
#endif

#define MPU6050_ADDR 0x68

// ==========================================
// THÔNG SỐ ROBOT CHUẨN KINEMATIC
// ==========================================
double L = 0.43; // Khoảng cách 2 bánh (m)
double R = 0.06; // Bán kính bánh xe (m)

const float ENCODER_REV_LEFT  = 18667.0;
const float ENCODER_REV_RIGHT = 18667.0;
const float STEPS_PER_WHEEL_REV = 8000.0; 

float TUNE_FWD = 1.0; 
float TUNE_BWD = 1.0; 

// ==========================================
// CHÂN KẾT NỐI (ARDUINO MEGA 2560)
// ==========================================
#define PUL_L 8
#define DIR_L 9
#define PUL_R 4
#define DIR_R 5

#define ENC_L_A 2
#define ENC_L_B 3
#define ENC_R_A 18
#define ENC_R_B 19

// ==========================================
// BIẾN ENCODER & DEBOUNCE
// ==========================================
volatile long pulLeft = 0;
volatile long pulRight = 0;
long pulPreLeft = 0;
long pulPreRight = 0;
long delta_tick_left = 0;
long delta_tick_right = 0;

volatile unsigned long lastTimeLeft = 0;
volatile unsigned long lastTimeRight = 0;
const unsigned long DEBOUNCE_TIME_US = 40; 

// ==========================================
// ODOMETRY & IMU GYRO
// ==========================================
float x = 0.0;
float y = 0.0;
float theta = 0.0;

float distanceLeft = 0.0;
float distanceRight = 0.0;
float delta_s = 0.0;
float delta_theta = 0.0;

float velLinear = 0.0;
float angLinear = 0.0;
float desiredVelLeft = 0.0;   
float desiredVelRight = 0.0;  

// Biến lưu vận tốc thực tế sau bộ lọc
float odom_vel_linear_real = 0.0;
float odom_vel_angular_real = 0.0;

float gyroZ_offset = 0.0;
unsigned long last_odom_time_us = 0;

// ==========================================
// ĐIỀU KHIỂN TẦN SỐ PHÁT XUNG BH57
// ==========================================
float targetPPSLeft = 0.0;   
float targetPPSRight = 0.0;
unsigned long lastPulseLeftMicros = 0;
unsigned long lastPulseRightMicros = 0;
bool pulseStateLeft = LOW;
bool pulseStateRight = LOW;
const unsigned int PULSE_HIGH_US = 5; 

// Cờ hiệu xử lý lệnh mới
bool newCmdReceived = false;

// ==========================================
// CẤU TRÚC UART GIAO TIẾP ROS2 (Chuẩn Pack 1)
// ==========================================
#pragma pack(1)
struct {
  float x;
  float y;
  float theta;
  float linear;
  float angular;
} odom_data;

struct {
  uint8_t header = 0xAA;
  float linear_vel;
  float angular_vel;
  uint8_t checksum;
} cmd_vel_data;
#pragma pack()

// ==========================================
// SETUP
// ==========================================
void setup() {
  Serial.begin(115200);
  setupIMU(); 

  pinMode(PUL_L, OUTPUT); pinMode(DIR_L, OUTPUT);
  pinMode(PUL_R, OUTPUT); pinMode(DIR_R, OUTPUT);
  digitalWrite(PUL_L, LOW); digitalWrite(PUL_R, LOW);

  pinMode(ENC_L_A, INPUT_PULLUP); pinMode(ENC_L_B, INPUT_PULLUP);
  pinMode(ENC_R_A, INPUT_PULLUP); pinMode(ENC_R_B, INPUT_PULLUP);

  attachInterrupt(digitalPinToInterrupt(ENC_L_A), readEncoderLeft, RISING);
  attachInterrupt(digitalPinToInterrupt(ENC_R_A), readEncoderRight, RISING);

  lastPulseLeftMicros = micros();
  lastPulseRightMicros = micros();
  last_odom_time_us = micros();
}

// ==========================================
// VÒNG LẶP CHÍNH (ĐÃ ĐỒNG BỘ LUỒNG)
// ==========================================
void loop() {
  // Ưu tiên số 1: Luôn chạy bộ phát xung mượt mà không bị chặn
  runStepperLeft();
  runStepperRight();

  // Đọc UART liên tục từng byte tránh nghẽn bộ đệm
  readUARTData();

  // Chỉ tính toán động học khi thực sự có gói tin mới từ ROS2 gửi xuống
  if (newCmdReceived) {
    newCmdReceived = false;
    float omegaL = (2.0 * velLinear - angLinear * L) / (2.0 * R);
    float omegaR = (2.0 * velLinear + angLinear * L) / (2.0 * R);
    desiredVelLeft = omegaL * (30.0 / PI);
    desiredVelRight = omegaR * (30.0 / PI);
    updateTargetPPS(); 
  }

  static unsigned long prev_odom_time = 0;
  static unsigned long prev_send_time = 0;
  unsigned long current_time = millis();
  
  // Tính toán Odometry (100Hz)
  if (current_time - prev_odom_time >= 10) { 
    calcOdometry(); 
    prev_odom_time = current_time; 
  }
  
  // Gửi dữ liệu Odom lên ROS2 (20Hz khớp hoàn toàn với chu kỳ nhận của Python)
  if (current_time - prev_send_time >= 50) { 
    sendOdometryData(); 
    prev_send_time = current_time; 
  }
}

void updateTargetPPS() {
  targetPPSLeft = fabs(desiredVelLeft) * STEPS_PER_WHEEL_REV / 60.0;
  targetPPSRight = fabs(desiredVelRight) * STEPS_PER_WHEEL_REV / 60.0;

  if (desiredVelLeft > 0) digitalWrite(DIR_L, HIGH);
  else if (desiredVelLeft < 0) digitalWrite(DIR_L, LOW);

  if (desiredVelRight > 0) digitalWrite(DIR_R, HIGH);
  else if (desiredVelRight < 0) digitalWrite(DIR_R, LOW);
}

void runStepperLeft() {
  if (targetPPSLeft <= 0.0) { digitalWrite(PUL_L, LOW); pulseStateLeft = LOW; return; }
  unsigned long now = micros();
  unsigned long period = (unsigned long)(1000000.0 / targetPPSLeft);
  
  if (pulseStateLeft == LOW) {
    if (now - lastPulseLeftMicros >= period) { 
      digitalWrite(PUL_L, HIGH); pulseStateLeft = HIGH; lastPulseLeftMicros = now; 
    }
  } else {
    if (now - lastPulseLeftMicros >= PULSE_HIGH_US) { 
      digitalWrite(PUL_L, LOW); pulseStateLeft = LOW; 
    }
  }
}

void runStepperRight() {
  if (targetPPSRight <= 0.0) { digitalWrite(PUL_R, LOW); pulseStateRight = LOW; return; }
  unsigned long now = micros();
  unsigned long period = (unsigned long)(1000000.0 / targetPPSRight);
  
  if (pulseStateRight == LOW) {
    if (now - lastPulseRightMicros >= period) { 
      digitalWrite(PUL_R, HIGH); pulseStateRight = HIGH; lastPulseRightMicros = now; 
    }
  } else {
    if (now - lastPulseRightMicros >= PULSE_HIGH_US) { 
      digitalWrite(PUL_R, LOW); pulseStateRight = LOW; 
    }
  }
}

void stopMotors() {
  desiredVelLeft = 0.0; desiredVelRight = 0.0;
  targetPPSLeft = 0.0; targetPPSRight = 0.0;
  digitalWrite(PUL_L, LOW); digitalWrite(PUL_R, LOW);
}

// ==========================================
// TÍNH TOÁN ODOMETRY CHÍNH XÁC THEO DT THỰC LẬP
// ==========================================
void calcOdometry() {
  unsigned long now_us = micros();
  float dt = (now_us - last_odom_time_us) / 1000000.0; 
  last_odom_time_us = now_us;

  if (dt <= 0.0) dt = 0.01; 

  long currentLeft, currentRight;
  noInterrupts(); 
  currentLeft = pulLeft; currentRight = pulRight;
  interrupts();

  delta_tick_left = currentLeft - pulPreLeft;
  delta_tick_right = currentRight - pulPreRight;
  pulPreLeft = currentLeft; pulPreRight = currentRight;

  distanceLeft  = 2.0 * PI * R * ((float)delta_tick_left / ENCODER_REV_LEFT);
  distanceRight = 2.0 * PI * R * ((float)delta_tick_right / ENCODER_REV_RIGHT);
  
  delta_s = (distanceRight + distanceLeft) / 2.0;

  if (delta_s > 0) delta_s *= TUNE_FWD;
  else if (delta_s < 0) delta_s *= TUNE_BWD;

  // ĐÃ SỬA: Tính vận tốc thực tế chia cho dt thực + Bộ lọc thông thấp LPF làm mịn phản hồi
  float raw_linear = delta_s / dt;
  odom_vel_linear_real = 0.7 * odom_vel_linear_real + 0.3 * raw_linear;

  // Đọc Gyro Z
  Wire.beginTransmission(MPU6050_ADDR);
  Wire.write(0x47); 
  Wire.endTransmission(false);
  Wire.requestFrom(MPU6050_ADDR, 2, true);
  int16_t gz_raw = (Wire.read() << 8 | Wire.read());

  float gz_rate_deg = ((float)gz_raw - gyroZ_offset) / 131.0; 
  float gz_rate_rad = gz_rate_deg * (PI / 180.0);

  if (fabs(gz_rate_rad) < 0.015) gz_rate_rad = 0.0;

  delta_theta = gz_rate_rad * dt;
  
  // ĐÃ SỬA: Làm mượt vận tốc góc thực tế gửi lên ROS2
  odom_vel_angular_real = 0.7 * odom_vel_angular_real + 0.3 * gz_rate_rad;

  if (delta_s != 0) {
    x = x + delta_s * cos(theta + (delta_theta / 2.0));  
    y = y + delta_s * sin(theta + (delta_theta / 2.0));  
  }
  
  theta = theta + delta_theta;
  if (theta > PI)  theta -= 2.0 * PI;
  if (theta < -PI) theta += 2.0 * PI;
}

void setupIMU() {
  Wire.begin(); 
  Wire.setClock(400000);
  Wire.beginTransmission(MPU6050_ADDR); Wire.write(0x6B); Wire.write(0x00); Wire.endTransmission(true);
  Wire.beginTransmission(MPU6050_ADDR); Wire.write(0x1B); Wire.write(0x00); Wire.endTransmission(true);
  Wire.beginTransmission(MPU6050_ADDR); Wire.write(0x1A); Wire.write(0x03); Wire.endTransmission(true);

  long sumZ = 0;
  for(int i = 0; i < 500; i++) {
    Wire.beginTransmission(MPU6050_ADDR); Wire.write(0x47); Wire.endTransmission(false);
    Wire.requestFrom(MPU6050_ADDR, 2, true);
    sumZ += (Wire.read() << 8 | Wire.read());
    delay(2); 
  }
  gyroZ_offset = (float)sumZ / 500.0;
}

// ĐỌC UART KHÔNG CHẶN
void readUARTData() {
  static byte buffer[sizeof(cmd_vel_data)];
  static int buffer_index = 0;
  static unsigned long last_byte_time = 0;
  const uint8_t MAGIC_HEADER = 0xAA;

  if (millis() - last_byte_time > 50 && buffer_index > 0) buffer_index = 0;
  if (Serial.available() == 0 && millis() - last_byte_time > 200) stopMotors();

  while (Serial.available() > 0) {
    byte incoming = Serial.read();
    if (buffer_index == 0 && incoming != MAGIC_HEADER) continue;
    buffer[buffer_index++] = incoming;
    last_byte_time = millis();

    if (buffer_index == sizeof(cmd_vel_data)) {
      uint8_t checksum = 0;
      for (size_t i = 0; i < sizeof(cmd_vel_data) - 1; i++) checksum ^= buffer[i];
      if (checksum == buffer[sizeof(cmd_vel_data) - 1]) {
        memcpy(&cmd_vel_data, buffer, sizeof(cmd_vel_data));
        if (fabs(cmd_vel_data.linear_vel) < 10.0f && fabs(cmd_vel_data.angular_vel) < 10.0f) {
          velLinear = cmd_vel_data.linear_vel;
          angLinear = cmd_vel_data.angular_vel;
          newCmdReceived = true; // Kích hoạt cờ hiệu tính toán
        }
      }
      buffer_index = 0;
    }
  }
}

void sendOdometryData() {
  odom_data.x = x; 
  odom_data.y = y; 
  odom_data.theta = theta;
  // ĐÃ SỬA: Gửi vận tốc thực tế đã làm mượt (Lưu ý: giữ nhân 1000.0 theo chuẩn định nghĩa cũ của bạn)
  odom_data.linear = odom_vel_linear_real * 1000.0; 
  odom_data.angular = odom_vel_angular_real * 1000.0;
  
  byte* dataPtr = (byte*)&odom_data;
  byte checksum = 0;
  for (size_t i = 0; i < sizeof(odom_data); i++) checksum ^= dataPtr[i];
  
  Serial.write(0xAA); 
  Serial.write(dataPtr, sizeof(odom_data)); 
  Serial.write(checksum); 
  Serial.write(0x55);
}

void readEncoderLeft() {
  unsigned long now = micros();
  if (now - lastTimeLeft < DEBOUNCE_TIME_US) return; 
  lastTimeLeft = now;
  if (digitalRead(ENC_L_A) == 1) { if (digitalRead(ENC_L_B) == 0) pulLeft++; else pulLeft--; } 
}

void readEncoderRight() {
  unsigned long now = micros();
  if (now - lastTimeRight < DEBOUNCE_TIME_US) return; 
  lastTimeRight = now;
  if (digitalRead(ENC_R_A) == 1) { if (digitalRead(ENC_R_B) == 0) pulRight--; else pulRight++; } 
}
